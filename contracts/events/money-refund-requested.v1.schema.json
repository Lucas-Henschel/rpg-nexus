{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:money-refund-requested:v1",
  "title": "MoneyRefundRequested v1",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "money.refund.requested.v1",
    "producer": "inventory (S3, P3)",
    "consumers": ["characters (S2, P2) — fila characters.money-commands.v1"]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.money.refund-requested.v1" },
    "version": { "const": 1 },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "payload": {
      "type": "object",
      "required": [
        "operationId",
        "campaignId",
        "userId",
        "characterId",
        "itemId",
        "amount"
      ],
      "additionalProperties": true,
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "userId": { "$ref": "#/$defs/id" },
        "characterId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "amount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
