{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:acquisition-cancelled:v1",
  "title": "AcquisitionCancelled v1",
  "description": "A Saga terminou sem entregar o item e o estoque foi liberado. Publicado sempre que a Saga já tinha pedido a validação do personagem: é este evento que faz o S2 devolver o espaço reservado na mochila.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "acquisition.cancelled.v1",
    "producer": "inventory (S3, P3)",
    "consumers": [
      "characters (S2, P2) — fila characters.acquisition-outcomes.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.acquisition.cancelled.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": [
        "operationId",
        "campaignId",
        "characterId",
        "itemId",
        "quantity",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "characterId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
        "reason": {
          "type": "string",
          "enum": [
            "CHARACTER_REJECTED",
            "EXTERNAL_VALIDATION_FAILED",
            "DEADLINE_EXPIRED"
          ],
          "description": "CHARACTER_REJECTED: o S2 recusou. EXTERNAL_VALIDATION_FAILED: o S4 recusou. DEADLINE_EXPIRED: a Saga passou do prazo sem resposta."
        },
        "detail": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
  }
}
