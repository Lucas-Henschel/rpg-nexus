{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:campaign-member-character-chosen:v1",
  "title": "CampaignMemberCharacterChosen v1",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "campaign.member.character-chosen.v1",
    "producer": "campaigns (S1, P1)",
    "consumers": ["inventory (S3, P3) — fila inventory.campaign-members.v1"]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.campaign.member.character-chosen.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": [
        "campaignId",
        "userId",
        "role",
        "characterId",
        "characterName"
      ],
      "properties": {
        "campaignId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["OWNER", "PLAYER"] },
        "characterId": { "type": "string", "minLength": 1 },
        "characterName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
