{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:money-refunded:v1",
  "title": "MoneyRefunded v1",
  "description": "O S2 devolveu o valor da operação (compensação concluída). amount 0 quando não havia débito para a operação.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "money.refunded.v1",
    "producer": "characters (S2, P2)",
    "consumers": [
      "inventory (S3, P3) — fila inventory.money-replies.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:rpg-nexus:envelope:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "rpg.money.refunded.v1"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "operationId",
        "campaignId",
        "characterId",
        "amount",
        "balance"
      ],
      "additionalProperties": true,
      "properties": {
        "operationId": {
          "$ref": "#/$defs/id"
        },
        "campaignId": {
          "$ref": "#/$defs/id"
        },
        "characterId": {
          "$ref": "#/$defs/id"
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "balance": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
