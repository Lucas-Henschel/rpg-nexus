{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:campaign-member-joined:v1",
  "title": "CampaignMemberJoined v1",
  "description": "Um usuário passou a participar da campanha: o dono ao criar (OWNER) ou um jogador que entrou pelo código (PLAYER). Entrar de novo quem já participa não gera evento. correlationId = campaignId.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "campaign.member.joined.v1",
    "producer": "campaigns (S1, P1)",
    "consumers": [
      "inventory (S3, P3) — fila inventory.campaign-members.v1",
      "characters (S2, P2) — fila characters.campaign-members.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.campaign.member.joined.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["campaignId", "userId", "username", "role", "joinedAt"],
      "additionalProperties": true,
      "properties": {
        "campaignId": { "$ref": "#/$defs/id" },
        "userId": { "$ref": "#/$defs/id" },
        "username": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "enum": ["OWNER", "PLAYER"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
  }
}
