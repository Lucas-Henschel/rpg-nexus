{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:campaign-member-removed:v1",
  "title": "CampaignMemberRemoved v1",
  "description": "Um jogador deixou de participar da campanha: saiu (LEFT) ou foi removido pelo dono (REMOVED). Quem projeta participantes revoga o acesso dele. correlationId = campaignId.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "campaign.member.removed.v1",
    "producer": "campaigns (S1, P1)",
    "consumers": [
      "inventory (S3, P3) — fila inventory.campaign-members.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.campaign.member.removed.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["campaignId", "userId", "removedBy", "reason", "removedAt"],
      "additionalProperties": true,
      "properties": {
        "campaignId": { "$ref": "#/$defs/id" },
        "userId": { "$ref": "#/$defs/id" },
        "removedBy": {
          "$ref": "#/$defs/id",
          "description": "Quem fez a remoção: o próprio usuário (LEFT) ou o dono (REMOVED)."
        },
        "reason": { "enum": ["LEFT", "REMOVED"] },
        "removedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
  }
}
