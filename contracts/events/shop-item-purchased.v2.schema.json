{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:shop-item-purchased:v2",
  "title": "ShopItemPurchased v2",
  "description": "O preço unitário passa de amount para unitPrice. v1 e v2 são aceitas durante a migração.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "shop.item.purchased.v2",
    "producer": "inventory (S3, P3)",
    "consumers": [
      "campaigns (S1, P1) — fila campaigns.activity.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.shop.item-purchased.v2" },
    "version": { "const": 2 },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "payload": {
      "type": "object",
      "required": ["operationId", "campaignId", "userId", "characterId", "itemId", "unitPrice", "quantity"],
      "additionalProperties": true,
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "userId": { "$ref": "#/$defs/id" },
        "characterId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "unitPrice": { "type": "integer", "minimum": 0 },
        "quantity": { "const": 1 },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
