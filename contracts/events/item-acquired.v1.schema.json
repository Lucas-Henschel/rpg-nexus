{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpg-nexus:event:item-acquired:v1",
  "title": "ItemAcquired v1",
  "description": "A Saga terminou com sucesso: o item está no inventário do personagem e a reserva de estoque foi confirmada.",
  "x-routing": {
    "exchange": "rpg.events",
    "routingKey": "item.acquired.v1",
    "producer": "inventory (S3, P3)",
    "consumers": [
      "campaigns (S1, P1) — fila campaigns.activity.v1",
      "characters (S2, P2) — fila characters.acquisition-outcomes.v1",
      "actions (S4, P4) — fila actions.history.v1"
    ]
  },
  "type": "object",
  "allOf": [{ "$ref": "urn:rpg-nexus:envelope:v1" }],
  "properties": {
    "type": { "const": "rpg.item.acquired.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": [
        "operationId",
        "campaignId",
        "characterId",
        "itemId",
        "quantity"
      ],
      "additionalProperties": true,
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "campaignId": { "$ref": "#/$defs/id" },
        "characterId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Opcional. Nome do item no momento da aquisição, para S1 e S4 exibirem sem consultar o S3."
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
  }
}
