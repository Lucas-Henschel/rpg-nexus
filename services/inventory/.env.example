AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=inventory-local
AWS_SECRET_ACCESS_KEY=inventory-local-secret
# Só para rodar fora do Docker: no Compose o endpoint vem do docker-compose.yml (MiniStack próprio,
# sem porta no host). Fora dele, suba um MiniStack seu, por exemplo:
# docker run --rm -p 4566:4566 ministackorg/ministack
DYNAMODB_ENDPOINT=http://localhost:4566
INVENTORY_TABLE_PREFIX=inventory_
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=dev
SPRING_RABBITMQ_PASSWORD=dev
RABBITMQ_EXCHANGE=rpg.events
RABBITMQ_QUEUE=inventory.saga-replies.v1
RABBITMQ_RETRY_QUEUE=inventory.saga-replies.v1.retry
RABBITMQ_MEMBERS_QUEUE=inventory.campaign-members.v1
RABBITMQ_MEMBERS_RETRY_QUEUE=inventory.campaign-members.v1.retry
RETRY_BASE_DELAY_MS=1000
SAGA_TIMEOUT_SECONDS=60
VALIDATION_EVENT_VERSION=0
MAX_RETRIES=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=dev-only-change-this-jwt-secret-32-characters
JWT_ISSUER=rpg-nexus-identity
JWT_AUDIENCE=rpg-nexus-services
