# HTTP
PORT=3002
TRACING_ENABLED=false
SERVICE_NAME=identity
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DynamoDB (MiniStack). As credenciais abaixo são apenas para desenvolvimento local.
# Só para rodar fora do Docker: no Compose o endpoint vem do docker-compose.yml (MiniStack próprio,
# sem porta no host). Fora dele, suba um MiniStack seu, por exemplo:
# docker run --rm -p 4566:4566 ministackorg/ministack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=identity-local
AWS_SECRET_ACCESS_KEY=identity-local-secret
TABLE_USERS=identity_users
TABLE_IDENTITIES=identity_unique_identifiers
TABLE_SESSIONS=identity_sessions
TABLE_LOGIN_ATTEMPTS=identity_login_attempts
TABLE_HISTORY=action_history
TABLE_HISTORY_INBOX=action_history_inbox
TABLE_HISTORY_MEMBERSHIPS=action_history_memberships
TABLE_AUDIT=identity_audit
TABLE_VALIDATION_INBOX=action_validation_inbox
TABLE_VALIDATION_OUTBOX=action_validation_outbox

# Historico de aquisicoes (RabbitMQ -> DynamoDB)
HISTORY_INBOX_TTL_DAYS=7
RABBITMQ_URL=amqp://dev:dev@localhost:5672/
RABBITMQ_QUEUE=actions.history.v1
RABBITMQ_RETRY_QUEUE=actions.history.v1.retry
RABBITMQ_EXCHANGE=rpg.events
VALIDATION_QUEUE=actions.validation-requested.v1
VALIDATION_RETRY_QUEUE=actions.validation-requested.v1.retry
# Dependência externa simulada: 0.0 nunca falha; 1.0 sempre falha.
VALIDATION_FAILURE_RATE=0
VALIDATION_MIN_DELAY_MS=100
VALIDATION_MAX_DELAY_MS=500
VALIDATION_OUTBOX_INTERVAL_MS=500
RABBITMQ_PREFETCH=16
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=15000
CONTRACTS_DIR=../../contracts

# JWT. Troque o segredo fora do ambiente local; são exigidos pelo menos 32 caracteres.
JWT_SECRET=dev-only-change-this-jwt-secret-32-characters
JWT_ISSUER=rpg-nexus-identity
JWT_AUDIENCE=rpg-nexus-services
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cinco falhas em 15 minutos bloqueiam o identificador por 15 minutos.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Parâmetros do scrypt usado no hash de senha.
PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
