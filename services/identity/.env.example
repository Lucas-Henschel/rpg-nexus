# HTTP
PORT=3002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DynamoDB (MiniStack). As credenciais abaixo são apenas para desenvolvimento local.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
TABLE_USERS=identity_users
TABLE_IDENTITIES=identity_unique_identifiers
TABLE_SESSIONS=identity_sessions

# JWT. Troque o segredo fora do ambiente local; são exigidos pelo menos 32 caracteres.
JWT_SECRET=dev-only-change-this-jwt-secret-32-characters
JWT_ISSUER=rpg-nexus-identity
JWT_AUDIENCE=rpg-nexus-services
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Parâmetros do scrypt usado no hash de senha.
PASSWORD_SCRYPT_N=16384
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
