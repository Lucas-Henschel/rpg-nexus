    "@fastify/cors": "^11.4.3",
    "@fastify/otel": "^1.0.1",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.3.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.7.2",
    "vitest": "^5.1.0"
