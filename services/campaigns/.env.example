# HTTP
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DynamoDB (MiniStack). As credenciais são fictícias e lidas pelo SDK da AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=campaigns-local
AWS_SECRET_ACCESS_KEY=campaigns-local-secret
TABLE_CAMPAIGNS=campaigns
TABLE_JOIN_CODES=campaign_join_codes
TABLE_MEMBERS=campaign_members
TABLE_ACTIVITY=campaign_activity
TABLE_OPERATIONS=campaign_operations
TABLE_INBOX=campaign_inbox
TABLE_OUTBOX=campaign_outbox
INBOX_TTL_DAYS=7

# Outbox: eventos publicados pelo S1 (CampaignCreated, CampaignMemberJoined, CampaignMemberRemoved)
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=30000
OUTBOX_TTL_DAYS=3

# Access token emitido pelo S4. O segredo é o mesmo do S4; no Compose vem de JWT_SECRET do .env da raiz.
JWT_SECRET=dev-only-change-this-jwt-secret-32-characters
JWT_ISSUER=rpg-nexus-identity
JWT_AUDIENCE=rpg-nexus-services

# S2 Personagens, consultado quando o dono escolhe o modelo de ficha. No Compose: http://characters:8000.
CHARACTERS_URL=http://localhost:8000
CHARACTERS_TIMEOUT_MS=3000

# RabbitMQ
RABBITMQ_URL=amqp://dev:dev@localhost:5672/
RABBITMQ_EXCHANGE=rpg.events
RABBITMQ_QUEUE=campaigns.activity.v1
RABBITMQ_RETRY_QUEUE=campaigns.activity.v1.retry
RABBITMQ_PREFETCH=16

# Retry / DLQ
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=15000

# Contratos de eventos (JSON Schema), relativo a esta pasta
CONTRACTS_DIR=../../contracts

# Tracing (OpenTelemetry). Fora do Docker fica desligado; no Compose vem ligado e aponta para o Jaeger.
TRACING_ENABLED=false
SERVICE_NAME=campaigns
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
