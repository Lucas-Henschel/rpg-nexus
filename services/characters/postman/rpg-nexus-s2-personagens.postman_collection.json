    {
      "name": "1. Fichas",
      "item": [
        {
          "name": "Criar ficha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/characters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters"
              ]
            },
            "description": "Salva o id em {{characterId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": \"{{campaignId}}\",\n  \"name\": \"Lyra Ventobravo\",\n  \"ownerId\": \"user-ana\",\n  \"description\": \"Ladina meio-elfa\",\n  \"attributes\": {\n    \"forca\": 15,\n    \"destreza\": 12,\n    \"carisma\": 8\n  },\n  \"skills\": {\n    \"furtividade\": 3\n  },\n  \"hp\": {\n    \"current\": 22,\n    \"max\": 22\n  },\n  \"maxItems\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set(\"characterId\", c.id);",
                  "pm.collectionVariables.set(\"version\", c.version);",
                  "pm.test(\"capacidade inicial\", () => pm.expect(c.capacity.slotsAvailable).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar ficha com Idempotency-Key (repita: 201 e depois 200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "demo-borin-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/characters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters"
              ]
            },
            "description": "Enviar duas vezes devolve a MESMA ficha (mesmo id), sem duplicar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaignId\": \"{{campaignId}}\",\n  \"name\": \"Borin Martelo\",\n  \"ownerId\": \"user-ana\",\n  \"description\": \"Ladina meio-elfa\",\n  \"attributes\": {\n    \"forca\": 15,\n    \"destreza\": 12,\n    \"carisma\": 8\n  },\n  \"skills\": {\n    \"furtividade\": 3\n  },\n  \"hp\": {\n    \"current\": 22,\n    \"max\": 22\n  },\n  \"maxItems\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 na primeira, 200 na repetição\", () => pm.expect([200, 201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar ficha",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/characters/{{characterId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters",
                "{{characterId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"version\", pm.response.json().version);",
                  "pm.test(\"tem ETag\", () => pm.response.to.have.header(\"ETag\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar fichas da campanha",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/characters?campaignId={{campaignId}}&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters"
              ],
              "query": [
                {
                  "key": "campaignId",
                  "value": "{{campaignId}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reservas de capacidade (holds)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/characters/{{characterId}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters",
                "{{characterId}}",
                "holds"
              ]
            },
            "description": "Vazio até o Inventário pedir validações; mostra HELD / COMMITTED / RELEASED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
