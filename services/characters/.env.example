# --- S2 Personagens: variáveis de ambiente (valores para o Docker Compose local) ---
SERVICE_NAME=characters
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173
ENABLE_INTERNAL_ENDPOINTS=true

# AWS / MiniStack (credenciais fictícias no emulador)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://ministack:4566
# URL que o NAVEGADOR usa para as URLs pré-assinadas do S3
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# DynamoDB (tabelas exclusivas do S2)
STORE_BACKEND=dynamodb
TABLE_CHARACTERS=characters
TABLE_INBOX=character_inbox
TABLE_OUTBOX=character_outbox
INBOX_TTL_DAYS=7

# S3
STORAGE_BACKEND=s3
S3_BUCKET=rpg-nexus-assets
S3_PORTRAIT_PREFIX=characters/
S3_PRESIGN_EXPIRES_SECONDS=300
PORTRAIT_MAX_BYTES=2097152

# RabbitMQ
MESSAGING_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=rpg.events
RABBITMQ_PREFETCH=16
RABBITMQ_DECLARE_TOPOLOGY=true
RABBITMQ_RECONNECT_INITIAL_MS=500
RABBITMQ_RECONNECT_MAX_MS=15000

# Retry / DLQ (F4)
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=15000
POISON_DIRECT_TO_DLQ=false

# Outbox
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_SECONDS=30
VALIDATE_OUTGOING_EVENTS=true

# Domínio
DEFAULT_MAX_ITEMS=10

# Injeção de falha (F2): off | once | always
FAULT_CRASH_BEFORE_ACK=off
