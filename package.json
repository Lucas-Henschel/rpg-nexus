{
  "name": "rpg-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "pnpm validate:contracts",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "dev": "pnpm infra:up && turbo run dev",
    "infra:up": "docker compose up --build --detach --wait",
    "infra:logs": "docker compose logs --follow",
    "down": "docker compose down"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "turbo": "2.11.11"
  }
}
