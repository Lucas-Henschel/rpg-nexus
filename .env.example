# Credenciais fictícias, exclusivas do desenvolvimento local.
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINISTACK_PORT=4566
# Endpoint para contêineres na rede Compose; no host use http://localhost:4566.
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
RPG_ASSETS_BUCKET=rpg-assets

# Portas publicadas no host pelo serviço de Personagens e pelo front-end.
CHARACTERS_PORT=8000
FRONTEND_PORT=5173
INVENTORY_PORT=8080
SAGA_TIMEOUT_SECONDS=60
MAX_RETRIES=3
