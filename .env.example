# Credenciais fictícias, exclusivas do desenvolvimento local.
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINISTACK_PORT=4566
# Cada serviço usa seu próprio MiniStack e credenciais locais. Só o endpoint de
# Personagens/S3 é publicado no host para URLs pré-assinadas dos retratos.
AWS_REGION=us-east-1
CAMPAIGNS_AWS_ACCESS_KEY_ID=campaigns-local
CAMPAIGNS_AWS_SECRET_ACCESS_KEY=campaigns-local-secret
CHARACTERS_AWS_ACCESS_KEY_ID=characters-local
CHARACTERS_AWS_SECRET_ACCESS_KEY=characters-local-secret
INVENTORY_AWS_ACCESS_KEY_ID=inventory-local
INVENTORY_AWS_SECRET_ACCESS_KEY=inventory-local-secret
IDENTITY_AWS_ACCESS_KEY_ID=identity-local
IDENTITY_AWS_SECRET_ACCESS_KEY=identity-local-secret
RPG_ASSETS_BUCKET=rpg-assets

# Portas publicadas no host pelos serviços e pelo front-end.
CHARACTERS_PORT=8000
CAMPAIGNS_PORT=3001
IDENTITY_PORT=3002
FRONTEND_PORT=5173
INVENTORY_PORT=8080
SAGA_TIMEOUT_SECONDS=60
MAX_RETRIES=3

# Assinatura dos JWTs no ambiente local. Use um segredo forte e externo ao repositório em produção.
JWT_SECRET=dev-only-change-this-jwt-secret-32-characters

# Autoescala do consumidor (perfil "autoscale"): limites e alvo de mensagens por réplica.
AUTOSCALE_MIN_REPLICAS=1
AUTOSCALE_MAX_REPLICAS=4
AUTOSCALE_MESSAGES_PER_REPLICA=100
# Fila observada, intervalo entre leituras e leituras seguidas abaixo do alvo antes de reduzir.
AUTOSCALE_QUEUE=characters.validation-requested.v1
AUTOSCALE_INTERVAL_SECONDS=5
AUTOSCALE_SCALE_DOWN_AFTER=3
# Atraso artificial por mensagem no S2, em ms; use só para a fila crescer na demonstração.
CONSUMER_SIMULATED_DELAY_MS=0

# Tracing distribuído (OpenTelemetry + Jaeger).
TRACING_ENABLED=true
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
